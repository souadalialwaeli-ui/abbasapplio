# abbasapplio — environment placeholders
# Copy to .env.local and fill in only if a future feature needs it.
# The v0.1 release needs NO server keys: Colab sessions are linked by the
# user pasting their own Gradio URL, stored locally on their device only.
# Never commit a real .env file.

# Optional: default Gradio share URL prefill (user can still change it).
# VITE_DEFAULT_GRADIO_URL=https://xxxxxx.gradio.live

# Optional: future direct Google Drive API integration (NOT used in v0.1).
# Drive access today happens inside the official Colab notebook only.
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
